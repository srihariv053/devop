# ==============================================================================
# SubSentry AI - Environment Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (true enables offline persistent storage & sample realistic Indian banking/OTT data)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Configuration (Optional - leave empty to use built-in local persistence engine)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Intelligence Configuration
# Set your Google Gemini API Key for dynamic SubSentry Intelligence AI
# When left unset or in demo mode, SubSentry AI uses its built-in deterministic financial heuristic reasoning engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Security & Encryption Salt for masked payment identifiers
APP_ENCRYPTION_SECRET=subsentry_super_secure_random_key_32_chars
